/**
 * __TITLE__
 *
 * Builds the workshop's Google Forms in your Google Drive. Google Forms cannot import a file directly, so this
 * Apps Script is the import: paste it into a new project at https://script.google.com, pick createAllForms in
 * the toolbar and press Run. Approve the permissions Google asks for (Forms, and Sheets/triggers if a form
 * saves responses to a sheet or closes at capacity). The log (View > Logs, or the Execution log) prints each
 * form's edit link and the respondent link to give back to the agent, which puts it on the flyer QR code.
 *
 * Generated by atr-lab-workshop (scripts/workshop.py forms build) from __SOURCES__.
 * Edit the .form.json files and rebuild rather than editing FORMS by hand.
 * Running it twice makes a second copy of each form.
 */

var FORMS = /*__FORMS__*/;

function createAllForms() {
  var results = [];
  FORMS.forEach(function (spec) {
    results.push(buildForm_(spec));
  });
  Logger.log('---- copy everything below back to the agent ----');
  results.forEach(function (r) {
    Logger.log(JSON.stringify(r));
  });
  return results;
}

function buildForm_(spec) {
  var form = FormApp.create(spec.title);
  form.setDescription(spec.description || '');
  form.setProgressBar(spec.progress_bar !== false);
  form.setCollectEmail(spec.collect_email === true);
  form.setAllowResponseEdits(spec.allow_response_edits === true);
  form.setShowLinkToRespondAgain(false);
  if (spec.confirmation) form.setConfirmationMessage(spec.confirmation);
  if (spec.closed_message) form.setCustomClosedFormMessage(spec.closed_message);
  if (spec.limit_one_response) form.setLimitOneResponsePerUser(true);

  (spec.sections || []).forEach(function (section, i) {
    if (i > 0) {
      var page = form.addPageBreakItem().setTitle(section.title || '');
      if (section.description) page.setHelpText(section.description);
    } else if (section.description) {
      form.addSectionHeaderItem().setTitle(section.title || '').setHelpText(section.description);
    }
    (section.items || []).forEach(function (item) {
      addItem_(form, item);
    });
  });

  if (typeof form.supportsAdvancedResponderPermissions === 'function' &&
      form.supportsAdvancedResponderPermissions()) {
    form.setPublished(true);
  }
  try {
    form.setAcceptingResponses(true);
  } catch (e) {
    Logger.log('Open ' + form.getEditUrl() + ' and press Publish: ' + e);
  }

  var result = {
    key: spec.key,
    title: spec.title,
    edit_url: form.getEditUrl(),
    respond_url: form.getPublishedUrl(),
    short_url: ''
  };
  try {
    result.short_url = form.shortenFormUrl(result.respond_url);
  } catch (e) {
    result.short_url = '';
  }

  if (spec.responses_sheet) {
    var sheet = SpreadsheetApp.create(spec.title + ' (responses)');
    form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());
    result.sheet_url = sheet.getUrl();
  }
  if (spec.capacity) {
    PropertiesService.getScriptProperties().setProperty('capacity_' + form.getId(), String(spec.capacity));
    ScriptApp.newTrigger('closeAtCapacity').forForm(form).onFormSubmit().create();
    result.capacity = spec.capacity;
  }
  return result;
}

function addItem_(form, item) {
  var made;
  switch (item.type) {
    case 'short_text':
    case 'email':
    case 'number':
      made = form.addTextItem();
      if (item.type === 'email') {
        made.setValidation(FormApp.createTextValidation()
          .setHelpText('Enter an email address.').requireTextIsEmail().build());
      } else if (item.type === 'number') {
        made.setValidation(FormApp.createTextValidation()
          .setHelpText('Enter a number.').requireNumber().build());
      }
      break;
    case 'paragraph':
      made = form.addParagraphTextItem();
      break;
    case 'multiple_choice':
      made = form.addMultipleChoiceItem().setChoiceValues(item.choices);
      if (item.other) made.showOtherOption(true);
      break;
    case 'checkboxes':
      made = form.addCheckboxItem().setChoiceValues(item.choices);
      if (item.other) made.showOtherOption(true);
      break;
    case 'dropdown':
      made = form.addListItem().setChoiceValues(item.choices);
      break;
    case 'scale':
      made = form.addScaleItem().setBounds(item.low || 1, item.high || 5);
      if (item.low_label || item.high_label) made.setLabels(item.low_label || '', item.high_label || '');
      break;
    case 'grid':
      made = form.addGridItem().setRows(item.rows).setColumns(item.columns);
      break;
    case 'checkbox_grid':
      made = form.addCheckboxGridItem().setRows(item.rows).setColumns(item.columns);
      break;
    case 'date':
      made = form.addDateItem();
      break;
    case 'time':
      made = form.addTimeItem();
      break;
    case 'section_header':
      made = form.addSectionHeaderItem();
      break;
    default:
      throw new Error('Unknown item type: ' + item.type);
  }
  made.setTitle(item.title);
  if (item.help) made.setHelpText(item.help);
  if (item.required && typeof made.setRequired === 'function') made.setRequired(true);
  return made;
}

// Runs on every submission (installable trigger); it must not end in an underscore, or triggers cannot call it.
function closeAtCapacity(e) {
  var form = e.source;
  var cap = Number(PropertiesService.getScriptProperties().getProperty('capacity_' + form.getId()) || 0);
  if (cap && form.getResponses().length >= cap) {
    form.setAcceptingResponses(false);
  }
}
